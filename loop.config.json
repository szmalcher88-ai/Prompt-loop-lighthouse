{
  "repo_dir": ".",
  "plan_file": "PLAN.md",
  "prompt_template": "PROMPT.template.md",
  "state_dir": ".loop",

  "agent_command": "claude -p --permission-mode acceptEdits --allowedTools \"Bash(python:*)\"",

  "verify_commands": [
    ["python", "-m", "compileall", "-q", "."],
    ["python", "scripts/test_checkers.py"],
    ["python", "scripts/check_parts.py"],
    ["python", "scripts/check_lighthouse.py"],
    ["python", "scripts/check_scene.py"],
    ["python", "scripts/render_test.py"]
  ],

  "max_iterations": 24,
  "max_retries_per_task": 3,
  "max_wall_seconds": 10800,
  "agent_timeout_seconds": 1200,
  "verify_timeout_seconds": 600,

  "protected_paths": ["tests/", "scripts/", ".github/", "loop.py", "loop.config.json", "PROMPT.template.md", "README.md", "INSTRUKCJE-KOLEJNA-SESJA.md", "ROZBIEZNOSCI.md", "parts/README.md", "LESSONS/", "budgets.json", "ART_DIRECTION.md", "art/"],
  "max_diff_lines": 800,

  "feedback_tail_chars": 4000,
  "on_escalation": "stop"
}
